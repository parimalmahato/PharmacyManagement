# Prefer scripts/init-docker.ps1 to generate these locally; never commit .env.
# Required. Use a strong password without semicolons/connection-string delimiters.
PHARMACY_SQL_PASSWORD=
# Required. Random signing key of at least 32 bytes.
PHARMACY_JWT_KEY=
PHARMACY_WEB_PORT=8080
PHARMACY_BOOTSTRAP_IDENTITY=false
PHARMACY_ADMIN_EMAIL=
PHARMACY_ADMIN_PASSWORD=
PHARMACY_ADMIN_NAME=Pharmacy Administrator

# Optional: start the ai Compose profile and install models before enabling.
PHARMACY_AI_ENABLED=false
PHARMACY_AI_MODEL=llama3.2:3b
PHARMACY_OLLAMA_URL=http://ollama:11434/
PHARMACY_VISION_MODEL=
PHARMACY_EMBEDDING_MODEL=
PHARMACY_VECTOR_ENABLED=false
